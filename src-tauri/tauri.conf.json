{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxel MC Launcher 2",
  "version": "0.1.0",
  "identifier": "com.zhl2010.voxel-launcher2",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Voxel Launcher",
        "width": 1240,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}